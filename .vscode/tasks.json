{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run GGUF Transformer Layer Demo",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_gguf_layer_demo.ps1"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run RoPE & M=1 Attention Benchmark",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_attention_benchmark.ps1"
            ],
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Aux Kernels Benchmark (RMSNorm + SwiGLU)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_aux_benchmark.ps1"
            ],
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run GGUF Q4_0 & Group-32 Benchmark",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_gemv_q4_benchmark.ps1"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run GEMV Roofline Benchmark",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_gemv_benchmark.ps1"
            ],
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run GPU Bandwidth Benchmark",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/run_bandwidth_test.ps1"
            ],
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Compile All Shaders",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/compile_shaders.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}

