#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Batched Fused Residual Add + RMSNorm (dispatch M, 1, 1)
layout(local_size_x = 128, local_size_y = 1) in;

layout(set = 0, binding = 0) readonly buffer VecA { f16vec4 a[]; };
layout(set = 0, binding = 1) readonly buffer VecB { f16vec4 b[]; };
layout(set = 0, binding = 2) readonly buffer GammaVector { f16vec4 gamma[]; };
layout(set = 0, binding = 3) writeonly buffer ResOut { f16vec4 res_out[]; };
layout(set = 0, binding = 4) writeonly buffer NormOut { f16vec4 norm_out[]; };

layout(push_constant) uniform PushConstants {
    uint K;
    uint K_vec4;
    float eps;
} pc;

shared float sg_sums[4];
shared float s_inv_rms;
shared vec4  s_x[256];

void main() {
    uint m = gl_WorkGroupID.x;
    uint rowOff = m * pc.K_vec4;
    uint tid = gl_LocalInvocationID.x;

    float local_sum = 0.0;
    for (uint i = tid; i < pc.K_vec4; i += 128u) {
        vec4 vx = vec4(a[rowOff + i]) + vec4(b[rowOff + i]);
        res_out[rowOff + i] = f16vec4(vx);
        if (i < 256u) {
            s_x[i] = vx;
        }
        local_sum += dot(vx, vx);
    }

    float sg_sum = subgroupAdd(local_sum);
    if (gl_SubgroupInvocationID == 0u) {
        sg_sums[gl_SubgroupID] = sg_sum;
    }
    barrier();

    if (tid == 0u) {
        float total_sum = 0.0;
        for (uint s = 0u; s < gl_NumSubgroups; ++s) {
            total_sum += sg_sums[s];
        }
        s_inv_rms = inversesqrt(total_sum / float(pc.K) + pc.eps);
    }
    barrier();

    float inv_rms = s_inv_rms;
    for (uint i = tid; i < pc.K_vec4; i += 128u) {
        vec4 vx = (i < 256u) ? s_x[i] : (vec4(a[rowOff + i]) + vec4(b[rowOff + i]));
        vec4 vg = vec4(gamma[i]);
        norm_out[rowOff + i] = f16vec4(vx * inv_rms * vg);
    }
}

