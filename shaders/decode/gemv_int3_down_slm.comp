#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : require

// Group-128 3-bit GEMV with SLM input x caching (for FFN Down projection, K=4864)
layout(local_size_x = 32, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer InputVector  { f16vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer WeightMatrix { uint W[]; };
layout(set = 0, binding = 2) readonly buffer ScaleMatrix  { float16_t scales[]; };
layout(set = 0, binding = 3) writeonly buffer OutputVector { float16_t y[]; };

layout(push_constant) uniform PushConstants {
    uint K_group32;
    uint N;
} pc;

shared f16vec4 s_x[1280];

void main() {
    uint tid = gl_LocalInvocationID.y * 32u + gl_LocalInvocationID.x;
    uint K_vec4 = pc.K_group32 * 8u;
    for (uint i = tid; i < K_vec4; i += 256u) {
        s_x[i] = x[i];
    }
    barrier();

    uint row = gl_WorkGroupID.x * 8u + gl_LocalInvocationID.y;
    if (row >= pc.N) return;

    uint laneId = gl_LocalInvocationID.x;
    float16_t acc = float16_t(0.0);

    uint rowOffset = row * pc.K_group32;
    for (uint col = laneId; col < pc.K_group32; col += 32u) {
        uint blockIdx = rowOffset + col;
        uint wIdx = blockIdx * 3u;
        uint u0 = W[wIdx + 0u];
        uint u1 = W[wIdx + 1u];
        uint u2 = W[wIdx + 2u];
        float16_t d = scales[blockIdx >> 2u];
        uint xb = col * 8u;

        float16_t gd = float16_t(0.0);
        gd += dot(f16vec4(float16_t(int((u0 >>  0u) & 7u) - 4), float16_t(int((u0 >>  3u) & 7u) - 4),
                          float16_t(int((u0 >>  6u) & 7u) - 4), float16_t(int((u0 >>  9u) & 7u) - 4)), s_x[xb + 0u]);
        gd += dot(f16vec4(float16_t(int((u0 >> 12u) & 7u) - 4), float16_t(int((u0 >> 15u) & 7u) - 4),
                          float16_t(int((u0 >> 18u) & 7u) - 4), float16_t(int((u0 >> 21u) & 7u) - 4)), s_x[xb + 1u]);
        gd += dot(f16vec4(float16_t(int((u0 >> 24u) & 7u) - 4), float16_t(int((u0 >> 27u) & 7u) - 4),
                          float16_t(int((u1 >>  0u) & 7u) - 4), float16_t(int((u1 >>  3u) & 7u) - 4)), s_x[xb + 2u]);
        gd += dot(f16vec4(float16_t(int((u1 >>  6u) & 7u) - 4), float16_t(int((u1 >>  9u) & 7u) - 4),
                          float16_t(int((u1 >> 12u) & 7u) - 4), float16_t(int((u1 >> 15u) & 7u) - 4)), s_x[xb + 3u]);
        gd += dot(f16vec4(float16_t(int((u1 >> 18u) & 7u) - 4), float16_t(int((u1 >> 21u) & 7u) - 4),
                          float16_t(int((u1 >> 24u) & 7u) - 4), float16_t(int((u1 >> 27u) & 7u) - 4)), s_x[xb + 4u]);
        gd += dot(f16vec4(float16_t(int((u2 >>  0u) & 7u) - 4), float16_t(int((u2 >>  3u) & 7u) - 4),
                          float16_t(int((u2 >>  6u) & 7u) - 4), float16_t(int((u2 >>  9u) & 7u) - 4)), s_x[xb + 5u]);
        gd += dot(f16vec4(float16_t(int((u2 >> 12u) & 7u) - 4), float16_t(int((u2 >> 15u) & 7u) - 4),
                          float16_t(int((u2 >> 18u) & 7u) - 4), float16_t(int((u2 >> 21u) & 7u) - 4)), s_x[xb + 6u]);
        uint q30 = (u0 >> 30u) | ((u2 >> 28u) & 4u);
        uint q31 = (u1 >> 30u) | ((u2 >> 29u) & 4u);
        gd += dot(f16vec4(float16_t(int((u2 >> 24u) & 7u) - 4), float16_t(int((u2 >> 27u) & 7u) - 4),
                          float16_t(int(q30) - 4), float16_t(int(q31) - 4)), s_x[xb + 7u]);

        acc += gd * d;
    }

    float16_t rowSum = subgroupAdd(acc);
    if (laneId == 0u) {
        y[row] = rowSum;
    }
}
