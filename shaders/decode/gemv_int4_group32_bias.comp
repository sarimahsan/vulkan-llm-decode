#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : require

// 256 threads per workgroup = 8 subgroups of 32 threads (8 rows/workgroup).
// Caches input vector x in Shared Local Memory (SLM) and fuses bias addition:
//   y[row] = (W[row] * x) + bias[row]
layout(local_size_x = 32, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer InputVector {
    f16vec4 x[];
};

layout(set = 0, binding = 1) readonly buffer WeightMatrixINT4 {
    uvec4 W[];
};

layout(set = 0, binding = 2) readonly buffer ScaleMatrix {
    float16_t scales[];
};

layout(set = 0, binding = 3) readonly buffer BiasVector {
    float16_t bias[];
};

layout(set = 0, binding = 4) writeonly buffer OutputVector {
    float16_t y[];
};

layout(push_constant) uniform PushConstants {
    uint K_group32; // K / 32
    uint N;         // Number of rows
} pc;

layout(constant_id = 0) const uint SCALE_SHIFT = 0u;

shared f16vec4 s_x[256]; // Up to K = 1024 (256 f16vec4s = 2 KB SLM)

void main() {
    uint tid = gl_LocalInvocationID.y * 32u + gl_LocalInvocationID.x;
    uint K_vec4 = pc.K_group32 * 8u;

    for (uint i = tid; i < K_vec4; i += 256u) {
        s_x[i] = x[i];
    }
    barrier();

    uint row = gl_WorkGroupID.x * 8u + gl_LocalInvocationID.y;
    if (row >= pc.N) return;

    uint laneId = gl_LocalInvocationID.x;
    float16_t acc = float16_t(0.0);

    uint rowOffset = row * pc.K_group32;
    for (uint col = laneId; col < pc.K_group32; col += 32u) {
        uint blockIdx = rowOffset + col;
        uvec4 packed_w = W[blockIdx];
        float16_t d = scales[blockIdx >> SCALE_SHIFT];

        uint x_base = col * 8u;
        float16_t group_dot = float16_t(0.0);

        for (uint c = 0u; c < 4u; ++c) {
            uint word = packed_w[c];
            f16vec4 w0 = f16vec4(
                float16_t(bitfieldExtract(word,  0, 4)),
                float16_t(bitfieldExtract(word,  4, 4)),
                float16_t(bitfieldExtract(word,  8, 4)),
                float16_t(bitfieldExtract(word, 12, 4))
            ) - float16_t(8.0);
            f16vec4 w1 = f16vec4(
                float16_t(bitfieldExtract(word, 16, 4)),
                float16_t(bitfieldExtract(word, 20, 4)),
                float16_t(bitfieldExtract(word, 24, 4)),
                float16_t(bitfieldExtract(word, 28, 4))
            ) - float16_t(8.0);
            group_dot += dot(w0, s_x[x_base + c * 2u + 0u])
                       + dot(w1, s_x[x_base + c * 2u + 1u]);
        }

        acc += group_dot * d;
    }

    float16_t rowSum = subgroupAdd(acc);
    if (laneId == 0u) {
        y[row] = rowSum + bias[row];
    }
}

