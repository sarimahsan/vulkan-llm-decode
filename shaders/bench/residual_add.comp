#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Vectorized elementwise residual addition: out = a + b
layout(local_size_x = 128, local_size_y = 1) in;

layout(set = 0, binding = 0) readonly buffer VecA {
    f16vec4 a[];
};

layout(set = 0, binding = 1) readonly buffer VecB {
    f16vec4 b[];
};

layout(set = 0, binding = 2) writeonly buffer VecOut {
    f16vec4 out_vec[];
};

layout(push_constant) uniform PushConstants {
    uint N_vec4;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.N_vec4) return;
    out_vec[idx] = a[idx] + b[idx];
}

