#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : require

// 128 threads per workgroup = 4 subgroups of 32 threads
// Each subgroup computes 1 output row of GEMV (y = W * x)
// Group-32 Quantization: 32 INT4 weights per uvec4, each group has its own FP16 scale
layout(local_size_x = 32, local_size_y = 4) in;

layout(set = 0, binding = 0) readonly buffer InputVector {
    f16vec4 x[]; // Vector of length K (stored as f16vec4)
};

layout(set = 0, binding = 1) readonly buffer WeightMatrixINT4 {
    uvec4 W[]; // Matrix of shape N x (K / 32) (stored as uvec4, row-major)
};

layout(set = 0, binding = 2) readonly buffer ScaleMatrix {
    float16_t scales[]; // Matrix of shape N x (K / 32) (one FP16 scale per 32 weights)
};

layout(set = 0, binding = 3) writeonly buffer OutputVector {
    float16_t y[]; // Output vector of length N
};

layout(push_constant) uniform PushConstants {
    uint K_group32; // K / 32 (number of 32-weight blocks per row)
    uint N;         // Number of rows
} pc;

void main() {
    uint row = gl_WorkGroupID.x * 4 + gl_LocalInvocationID.y;
    if (row >= pc.N) return;

    uint laneId = gl_LocalInvocationID.x; // 0..31

    float16_t acc = float16_t(0.0);

    uint rowOffset = row * pc.K_group32;
    for (uint col = laneId; col < pc.K_group32; col += 32) {
        uint blockIdx = rowOffset + col;
        uvec4 packed_w = W[blockIdx];
        float16_t d = scales[blockIdx];

        uint x_base = col * 8u;
        float16_t group_dot = float16_t(0.0);

        for (uint c = 0u; c < 4u; ++c) {
            uint word = packed_w[c];
            f16vec4 w0 = f16vec4(
                float16_t(bitfieldExtract(word,  0, 4)),
                float16_t(bitfieldExtract(word,  4, 4)),
                float16_t(bitfieldExtract(word,  8, 4)),
                float16_t(bitfieldExtract(word, 12, 4))
            ) - float16_t(8.0);
            f16vec4 w1 = f16vec4(
                float16_t(bitfieldExtract(word, 16, 4)),
                float16_t(bitfieldExtract(word, 20, 4)),
                float16_t(bitfieldExtract(word, 24, 4)),
                float16_t(bitfieldExtract(word, 28, 4))
            ) - float16_t(8.0);
            group_dot += dot(w0, x[x_base + c * 2u + 0u])
                       + dot(w1, x[x_base + c * 2u + 1u]);
        }

        acc += group_dot * d;
    }

    // Hardware SIMD32 Subgroup Reduction
    float16_t rowSum = subgroupAdd(acc);

    if (laneId == 0) {
        y[row] = rowSum;
    }
}
