#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer InBuffer {
    uvec4 inData[];
};

layout(set = 0, binding = 1) writeonly buffer OutBuffer {
    uvec4 outData[];
};

layout(push_constant) uniform PushConstants {
    uint numElements; // total number of uvec4 elements
} pc;

void main() {
    // 4x unrolled 128-bit memory transactions (64 bytes per thread)
    uint baseIdx = gl_GlobalInvocationID.x * 4;

    if (baseIdx + 3 < pc.numElements) {
        outData[baseIdx + 0] = inData[baseIdx + 0];
        outData[baseIdx + 1] = inData[baseIdx + 1];
        outData[baseIdx + 2] = inData[baseIdx + 2];
        outData[baseIdx + 3] = inData[baseIdx + 3];
    } else {
        for (uint i = 0; i < 4; ++i) {
            uint idx = baseIdx + i;
            if (idx < pc.numElements) {
                outData[idx] = inData[idx];
            }
        }
    }
}

